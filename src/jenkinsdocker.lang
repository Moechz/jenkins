# ===========================================================================
# Multilingual file for the TOS 7 Docker application "jenkinsdocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "Official Jenkins Docker image"
auth         = "jenkinsci"
version      = "@@VERSION@@"
descript     = "Jenkins is a self-hosted CI/CD server: build, test and deploy with pipelines, jobs, agents, credentials and build history. This package runs the official Docker Hub image unmodified on TOS 7, stores all persistent data in the app data folder on your NAS, and opens the login page. Usage statistics and telemetry are disabled; only the update centre, plugin downloads and Docker Hub need internet."
release_note = "Rectified per review comments (C3/C4/C6/C8/T1). (1) Upgraded jenkins/jenkins:2.541.3-lts-jdk17 to jenkins/jenkins:2.580.2-lts-jdk21, the current LTS, multi-arch amd64/arm64. 2.580.2 fixes the high-severity Jenkins core issues in the 2026-10-28 advisory (CVE-2026-117612, -117613, -117614, -117615, -117616, -117617) and moves the runtime to Java 21. Existing JENKINS_HOME data is compatible: back up first, update plugins after the core upgrade, and roll back by restoring the backup and the old tag if a plugin is not yet compatible. (2) Added a complete PRIVACY.md covering stored data, retention, user rights, security measures, deletion and every third-party endpoint, and linked it from help. (3) Disabled Jenkins usage statistics and telemetry by default with -Dhudson.model.UsageStatistics.disabled=true; documented the update centre, the Google connectivity check, Docker Hub and job/plugin traffic. (4) The app now opens /login (HTTP 200) instead of /, which returns 403 before login, so the App Center self-test can open it; the health check probes the same page. (5) README, CHANGELOG, NOTICE and LICENSE updated."
important    = "First start: open the app, read the initial admin password from DockerAppData/jenkinsdocker/var_jenkins_home/secrets/initialAdminPassword, finish setup and change it. Data stays in that folder and survives restarts/updates; back it up before uninstall. Runs as uid 1000. Usage statistics and telemetry are disabled; updates need internet. Plain HTTP on the LAN - use a TLS reverse proxy. Credentials are encrypted, but the key is in the same folder: protect the data directory and its backups."

[zh-cn]
name         = "Official Jenkins Docker image"
auth         = "jenkinsci"
version      = "@@VERSION@@"
descript     = "Jenkins 是自建 CI/CD 服务器：用流水线构建、测试和部署，管理任务、代理、凭据和构建历史。本应用在 TOS 7 上运行 Docker Hub 官方镜像（未修改），所有持久数据保存在 NAS 的应用数据目录，打开后直接进入登录页。已默认关闭使用统计和遥测；只有更新中心、插件下载和 Docker Hub 需要联网。"
release_note = "已按审核意见整改（C3/C4/C6/C8/T1）。(1) 镜像从 jenkins/jenkins:2.541.3-lts-jdk17 升级到 jenkins/jenkins:2.580.2-lts-jdk21（当前 LTS，amd64/arm64 多架构）。2.580.2 修复了 2026-10-28 安全公告中的高危核心漏洞（CVE-2026-117612、-117613、-117614、-117615、-117616、-117617），运行时升级到 Java 21。原 JENKINS_HOME 数据兼容：升级前先备份，升级核心后更新插件；若插件暂不兼容，可恢复备份并回退旧标签。(2) 新增完整 PRIVACY.md：存储内容、保留期、用户权利、安全措施、删除渠道和全部第三方端点，并在 help 中链接。(3) 通过 -Dhudson.model.UsageStatistics.disabled=true 默认关闭 Jenkins 使用统计和遥测；并披露更新中心、Google 连通性检查、Docker Hub 及任务/插件流量。(4) 应用改为打开 /login（HTTP 200），不再打开登录前返回 403 的根路径，便于应用中心自检打开；健康检查同步修改。(5) 更新 README、CHANGELOG、NOTICE 和 LICENSE。"
important    = "首次启动：打开应用，从 DockerAppData/jenkinsdocker/var_jenkins_home/secrets/initialAdminPassword 读取初始管理员密码，完成安装向导并修改密码。数据保存在该目录，重启/升级不丢失；卸载前请备份。容器以 uid 1000 运行。使用统计和遥测已关闭；更新中心和插件安装需要联网。局域网内为 HTTP，请用 TLS 反向代理。凭据有加密，但密钥在同一目录，请保护数据目录和备份。"

[zh-hk]
name         = "Official Jenkins Docker image"
auth         = "jenkinsci"
version      = "@@VERSION@@"
descript     = "Jenkins 是自建 CI/CD 伺服器：用流水線建置、測試和部署，管理工作、代理、憑證和建置歷史。本應用在 TOS 7 上執行 Docker Hub 官方映像（未修改），所有持久資料保存在 NAS 的應用資料目錄，開啟後直接進入登入頁。已預設關閉使用統計和遙測；只有更新中心、外掛下載和 Docker Hub 需要連網。"
release_note = "已按審核意見整改（C3/C4/C6/C8/T1）。(1) 映像從 jenkins/jenkins:2.541.3-lts-jdk17 升級到 jenkins/jenkins:2.580.2-lts-jdk21（目前 LTS，amd64/arm64 多架構）。2.580.2 修復了 2026-10-28 安全公告中的高危核心漏洞（CVE-2026-117612、-117613、-117614、-117615、-117616、-117617），執行環境升級到 Java 21。原 JENKINS_HOME 資料相容：升級前先備份，升級核心後更新外掛；若外掛暫不相容，可還原備份並回退舊標籤。(2) 新增完整 PRIVACY.md：儲存內容、保留期、使用者權利、安全措施、刪除渠道和全部第三方端點，並在 help 中連結。(3) 透過 -Dhudson.model.UsageStatistics.disabled=true 預設關閉 Jenkins 使用統計和遙測；並披露更新中心、Google 連通性檢查、Docker Hub 及工作/外掛流量。(4) 應用改為開啟 /login（HTTP 200），不再開啟登入前回傳 403 的根路徑，便於應用中心自檢開啟；健康檢查同步修改。(5) 更新 README、CHANGELOG、NOTICE 和 LICENSE。"
important    = "首次啟動：開啟應用，從 DockerAppData/jenkinsdocker/var_jenkins_home/secrets/initialAdminPassword 讀取初始管理員密碼，完成安裝精靈並修改密碼。資料保存在該目錄，重新啟動/升級不遺失；解除安裝前請備份。容器以 uid 1000 執行。使用統計和遙測已關閉；更新中心和外掛安裝需要連網。區域網路內為 HTTP，請用 TLS 反向代理。憑證有加密，但金鑰在同一目錄，請保護資料目錄和備份。"

